set -e

executable_files=()
output_dir="./output"
packer_dir_name="sopacker-tmpdir"

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        "-h"|"--help")
            echo "Usage: "$0" [executable_file ...] [--output=output_dir]"
            echo "  executable_file: one or more paths to executable files"
            echo "  --output: (optional) the path to the output directory (default: ./output)"
            exit 0
        ;;
        --output=*)
            output_dir="${1#*=}"
            shift
        ;;
        *)
            executable_files+=("$1")
            shift
        ;;
    esac
done

# Check if executable file is provided
if [ ${#executable_files[@]} -eq 0 ]; then
    echo "Error: No executable file provided" >&2
    echo "Run './packer.sh --help' for usage information"
    exit 1
fi

# Validate executables and ensure unique output names
declare -A output_name_seen
base_names=()
for executable_file in "${executable_files[@]}"; do
    if [ ! -f "$executable_file" ]; then
        echo "Error: Executable file '$executable_file' not found" >&2
        exit 1
    fi

    base_name=$(basename "$executable_file")
    if [ -n "${output_name_seen[$base_name]}" ]; then
        echo "Error: Duplicate executable basename '$base_name'. Please rename inputs." >&2
        exit 1
    fi
    output_name_seen[$base_name]=1
    base_names+=("$base_name")
done

# Pack the dependencies into a tarball
echo "Packing dependencies into '$output_dir'"
# Get the absolute path of the script
script=$(readlink -f "$0")

# Create output directory
if [ ! -d "$output_dir" ]; then
    echo "Creating output directory '$output_dir'"
    mkdir -p "$output_dir"
fi

# Collect required libraries for all executables (deduplicated)
declare -A src_seen
src_files=()

lib_interp=""
lib_interp_name=""

for executable_file in "${executable_files[@]}"; do
    cur_interp=$(readelf -l "$executable_file" 2>/dev/null | awk -F': ' '/Requesting program interpreter/ { gsub(/[\[\]]/,"",$2); print $2; exit }')
    if [ -z "$cur_interp" ]; then
        echo "Error: Failed to detect ELF interpreter (PT_INTERP) for '$executable_file'" >&2
        exit 1
    fi

    cur_interp_name=$(basename "$cur_interp")
    if [ -z "$lib_interp" ]; then
        lib_interp="$cur_interp"
        lib_interp_name="$cur_interp_name"
    else
        if [ "$cur_interp_name" != "$lib_interp_name" ]; then
            echo "Error: Multiple ELF interpreters detected: '$lib_interp_name' and '$cur_interp_name'." >&2
            exit 1
        fi
    fi

    if [ -z "${src_seen[$executable_file]}" ]; then
        src_seen[$executable_file]=1
        src_files+=("$executable_file")
    fi

    libs=$(ldd "$executable_file" 2>/dev/null | grep -oP '=> \K[^ ]+')
    for lib in $libs; do
        if [ -f "$lib" ] && [ -z "${src_seen[$lib]}" ]; then
            src_seen[$lib]=1
            src_files+=("$lib")
        fi
    done
done

if [ ! -f "$lib_interp" ]; then
    echo "Error: ELF interpreter '$lib_interp' not found on this system" >&2
    exit 1
fi
if [ -z "${src_seen[$lib_interp]}" ]; then
    src_seen[$lib_interp]=1
    src_files+=("$lib_interp")
fi

# Compute a stable bundle id from the content of all inputs
bundle_id=$( (for f in "${src_files[@]}"; do sha256sum "$f"; done) | sort -k2 | sha256sum | awk '{print $1}')
runtime_tempdir="/tmp/sopacker-$bundle_id"

# Build directory (packaging-time)
tempdir=$(mktemp -d "/tmp/$packer_dir_name.build.XXXXXX")

if [ ! -x "patchelf" ]; then
    if [ ! -d "patchelf_src/.git" ]; then
        git submodule update --init --recursive
    fi
    pushd patchelf_src > /dev/null
    ./bootstrap.sh
    ./configure
    make
    cp src/patchelf ../
    popd > /dev/null
fi

# Copy executables, libs and required tools to the build directory
for executable_file in "${executable_files[@]}"; do
    cp -f "$executable_file" "$tempdir"
done
cp -f "$lib_interp" "$tempdir"
cp -f ./patchelf "$tempdir/__sopacker_patchelf"

for f in "${src_files[@]}"; do
    if [ "$f" != "$lib_interp" ]; then
        cp -f "$f" "$tempdir"
    fi
done

# Change to the temporary directory
pushd "$tempdir" >/dev/null

# Update the rpath and interpreter for all binaries
for file in *; do
    if ! echo "$file" | grep -Eq 'ld-linux|__sopacker_patchelf'; then
        echo "patching $file"
        if ! ldd $file | grep -q "statically linked"; then
            ./\__sopacker_patchelf --set-rpath "$runtime_tempdir" "$file"
            if readelf -l $file | grep -q INTERP; then
                ./\__sopacker_patchelf --set-interpreter "$runtime_tempdir/$lib_interp_name" "$file"
            fi
        fi
    fi
done

# Create a tar archive of the files in the build directory, excluding the helper patchelf
tar -cf "./bundle.tar" --exclude='__sopacker_patchelf' *

# Get the offset of the tar file in the script
offset=$(awk '/^__UNPACK_FOLLOWS__/ { print NR + 1; exit 0; }' "$script")

for base_name in "${base_names[@]}"; do
    # Replace the executable with a wrapper script of the same name
    rm -f "./$base_name"

    # Extract the wrapper template from this script
    tail -n+$offset "$script" > "$base_name"

    # Append the shared tar payload
    cat "./bundle.tar" >> "$base_name"

    # Inject runtime parameters (shared tempdir/bundle id, per-exec execname)
    sed -i "2a\bundle_id=$bundle_id" "$base_name"
    sed -i "2a\interpname=$lib_interp_name" "$base_name"
    sed -i "2a\execname=$base_name" "$base_name"
    sed -i "2a\tempdir=$runtime_tempdir" "$base_name"

    chmod +x "$base_name"
done

# Change back to the original directory
popd >/dev/null

# Copy wrappers to output
for base_name in "${base_names[@]}"; do
    cp -f "$tempdir/$base_name" "$output_dir"
    chmod +x "$output_dir/$base_name"
done

# Remove the temporary directory
rm -rf "$tempdir"

echo "Done!"

exit 0

__UNPACK_FOLLOWS__
