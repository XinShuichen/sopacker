is_bundle_ready() {
    local dir="$1"
    local expected_bundle_id="$2"
    local filename="$3"

    if [ -f "$dir/.sopacker_bundle_id" ] && [ -f "$dir/$filename" ]; then
        local actual_bundle_id
        actual_bundle_id=$(cat "$dir/.sopacker_bundle_id" 2>/dev/null || true)
        if [ "$actual_bundle_id" = "$expected_bundle_id" ]; then
            return 0
        fi
    fi

    return 1
}

mkdir -p "$tempdir"

# Lock to avoid concurrent partial extraction
if command -v flock >/dev/null 2>&1; then
    exec 9>"$tempdir/.sopacker_lock"
    flock -x 9
fi

if ! is_bundle_ready "$tempdir" "$bundle_id" "$execname"; then
    rm -rf "$tempdir"/*
    offset=$(awk '/^__TARFILE_FOLLOWS__/ { print NR + 1; exit 0; }' "$0")
    tail -n+$offset "$0" | tar -xf - -C "$tempdir" >/dev/null 2>&1
    echo "$bundle_id" > "$tempdir/.sopacker_bundle_id"
fi

# Execute the program with the provided arguments.
# NOTE: `ldd` on the extracted executable is misleading because the system `ldd` script
# uses the host loader to trace dependencies. We explicitly invoke the bundled loader.
exec "$tempdir/$interpname" \
    --library-path "$tempdir" \
    "$tempdir/$execname" "$@"

__TARFILE_FOLLOWS__
